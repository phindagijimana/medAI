# Copy to .env and adjust. python-dotenv loads this automatically if installed.

# Application
APP_HOME=
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8085

# Model (Hugging Face)
MODEL_NAME=m42-health/Llama3-Med42-8B
# HF_TOKEN=

# Security (required for stable sessions / production)
# SECRET_KEY=generate-a-long-random-string

# CORS: comma-separated origins. Leave empty to allow any origin (dev only).
# CORS_ORIGINS=https://your-domain.example,http://localhost:3000

# Concurrency (app-level queue for /analyze)
MAX_CONCURRENT_USERS=10

# Inference speed (Med42 generate)
# Lower max tokens = faster responses. Greedy decoding is faster than sampling (less natural).
# VECTA_MAX_NEW_TOKENS=384
# VECTA_GREEDY_FAST=0

# Long input: split medical text into chunks and run sequential passes (carry-forward excerpt).
# Default 3200 chars per chunk; set to 0 to disable chunking and use legacy single truncation (~4000 chars).
# VECTA_CHUNK_CHARS=3200
# VECTA_CHUNK_CARRY_CHARS=1500

# RAG + few-shot (prompt augmentation) — defaults are ON in app if unset
USE_RAG=1
USE_FEW_SHOT=1
# HPC GPU jobs: ./vecta-hpc sets VECTA_REQUIRE_GPU=1 so the service refuses CPU-only PyTorch on a GPU node
# VECTA_REQUIRE_GPU=0

# Set both to 0 only for fastest prompt build when you do not need retrieval/few-shot:
# USE_RAG=0
# USE_FEW_SHOT=0
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# RAG_CACHE_DIR=
# RAG_FORCE_REINDEX=0

# Uploads
MAX_CONTENT_LENGTH=52428800

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SERVICE_LOG_DIR=

# Gunicorn (production)
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=600
# GUNICORN_BIND=0.0.0.0:8085
