# MedAI-EPI — research phenotyping assistant, epilepsy specialty
# Copy to .env and adjust. python-dotenv loads this automatically if installed.
# Every variable below has a working default; only APP_HOME and SECRET_KEY
# should always be set for a non-dev deployment.

# ---------------------------------------------------------------------------
# Application root and network
# ---------------------------------------------------------------------------
# APP_HOME must point at the directory containing app.py. Left blank the app
# falls back to the current working directory, which is fragile on SLURM.
APP_HOME=/path/to/med42_service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8085

# Required for stable Flask sessions in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=generate-a-long-random-string
# FLASK_SECRET_KEY=  # alias for SECRET_KEY

# CORS: comma-separated origins. Leave empty to allow any origin (dev only).
# CORS_ORIGINS=https://your-domain.example,http://localhost:3000

# Uploads (bytes) — the /extract/csv endpoint accepts CSV files up to this size.
MAX_CONTENT_LENGTH=52428800

# ---------------------------------------------------------------------------
# Med42-8B model backend
# ---------------------------------------------------------------------------
MODEL_NAME=m42-health/Llama3-Med42-8B

# Hugging Face token — required to download Med42 weights on first launch.
# HF_TOKEN=

# On GPU nodes, refuse to run if CUDA is not available. Guards against a
# CPU-only PyTorch wheel accidentally landing on a GPU slot.
MEDAI_REQUIRE_GPU=1

# Inference device.
#   auto (default) → CUDA if available, else CPU (with warning)
#   cuda           → require CUDA, fail loudly if absent
#   cpu            → force CPU (~50-100× slower than GPU; useful for testing
#                     the pipeline on a laptop or in CI)
MEDAI_DEVICE=auto

# Deterministic decoding budget on /extract/* calls.
# 1024 = paper baseline (Table 4). 4096 = the sensitivity sweep (SLURM 103501).
MEDAI_MAX_NEW_TOKENS=1024

# ---------------------------------------------------------------------------
# Fine-tuned mode (LoRA adapter + schema-constrained decoding)
# ---------------------------------------------------------------------------
# Point at a PEFT adapter directory produced by scripts/finetune_lora_epi.py
# (or downloaded from the released Hugging Face repo). When set, the backend
# layers the LoRA adapter on top of the base Med42-8B weights at load time.
# The medai-epi CLI's `extract --lora-adapter DIR` sets this variable in-process.
# MEDAI_LORA_ADAPTER_DIR=checkpoints/llama3-med42-8b_lora_epi

# Set to 1 to enable schema-constrained decoding (logits masking against the
# EpilepsyPhenotype JSON schema, via lm-format-enforcer / outlines). Guarantees
# valid JSON on every generation; adds ~10-20% latency.
# MEDAI_CONSTRAINED=1

# ---------------------------------------------------------------------------
# Run manifests — every extraction writes one JSON line here.
# ---------------------------------------------------------------------------
# Default is data/run_manifests/<date>/ under APP_HOME. Override when running
# a sensitivity sweep so it does NOT overwrite the baseline directory.
# MEDAI_MANIFEST_DIR=/absolute/path/to/manifests

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# SERVICE_LOG_DIR=logs

# ---------------------------------------------------------------------------
# Production (gunicorn) — optional. Flask dev server is fine for research.
# ---------------------------------------------------------------------------
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=600
# GUNICORN_BIND=0.0.0.0:8085
