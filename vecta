#!/usr/bin/env python3
"""
Vecta AI — local CLI: install deps from requirements.txt, start/stop/status/logs.

  ./vecta install          # pip install -r requirements.txt
  ./vecta start            # Gunicorn in background (production-style)
  ./vecta start -f         # Flask dev server in foreground (python app.py)
  ./vecta stop | status | logs | restart
"""
import argparse
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

APP_DIR = Path(__file__).resolve().parent
REQUIREMENTS = APP_DIR / "requirements.txt"
GUNICORN_CFG = APP_DIR / "gunicorn_config.py"
APP_PY = APP_DIR / "app.py"
PID_FILE = APP_DIR / "vecta_ai.pid"
LOG_FILE = APP_DIR / "logs" / "vecta_ai.log"

# Prefer --user on shared clusters; set VECTA_PIP_USER=0 to disable
def _pip_user_args():
    v = os.environ.get("VECTA_PIP_USER", "1").lower()
    return ["--user"] if v in ("1", "true", "yes") else []


def check_imports():
    """Return list of missing import names (empty if OK)."""
    checks = [
        ("flask", "flask"),
        ("flask_cors", "flask_cors"),
        ("pandas", "pandas"),
        ("numpy", "numpy"),
        ("torch", "torch"),
        ("transformers", "transformers"),
        ("gunicorn", "gunicorn"),
    ]
    missing = []
    for mod, pip_hint in checks:
        try:
            __import__(mod)
        except ImportError:
            missing.append(pip_hint)
    return missing


def run_install():
    """Install everything from requirements.txt."""
    if not REQUIREMENTS.is_file():
        print(f"[ERROR] Missing {REQUIREMENTS}")
        return False
    print(f"Installing from {REQUIREMENTS.name} ...")
    cmd = [sys.executable, "-m", "pip", "install"] + _pip_user_args() + ["-r", str(REQUIREMENTS)]
    try:
        subprocess.check_call(cmd, cwd=str(APP_DIR))
        print("[OK] Dependencies installed.")
        return True
    except subprocess.CalledProcessError as e:
        print(f"[ERROR] pip install failed (exit {e.returncode})")
        return False


def ensure_dependencies():
    """Install from requirements.txt if core imports are missing."""
    missing = check_imports()
    if not missing:
        return True
    print(f"Missing packages: {', '.join(missing)}")
    if not run_install():
        return False
    still = check_imports()
    if still:
        print(f"[ERROR] Still missing after install: {', '.join(still)}")
        return False
    return True


def get_pid_info():
    if not PID_FILE.exists():
        return None, None
    try:
        content = PID_FILE.read_text().strip()
        if ":" in content:
            a, b = content.split(":", 1)
            return int(a), int(b)
        return int(content), None
    except Exception:
        return None, None


def is_process_running(pid):
    if pid is None:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def cmd_install(_args):
    print_banner()
    ok = run_install()
    return 0 if ok else 1


def cmd_start(args):
    print_banner()
    port = args.port if args.port is not None else int(os.environ.get("SERVICE_PORT", "8085"))
    os.environ["SERVICE_PORT"] = str(port)
    os.environ.setdefault("SERVICE_HOST", "0.0.0.0")
    os.environ.setdefault("APP_HOME", str(APP_DIR))

    if not ensure_dependencies():
        return 1

    pid, _ = get_pid_info()
    if pid and is_process_running(pid):
        print(f"[OK] Vecta AI is already running (PID: {pid}, port: {port})")
        print(f"\n   Main App:   http://localhost:{port}")
        print(f"   Validator:  http://localhost:{port}/validate\n")
        return 0

    (APP_DIR / "logs").mkdir(parents=True, exist_ok=True)

    if args.foreground:
        print("Starting Flask development server (foreground, Ctrl+C to stop)...\n")
        try:
            os.chdir(APP_DIR)
            os.environ["SERVICE_PORT"] = str(port)
            os.environ["SERVICE_HOST"] = os.environ.get("SERVICE_HOST", "0.0.0.0")
            os.environ["APP_HOME"] = str(APP_DIR)
            os.execvp(sys.executable, [sys.executable, str(APP_PY)])
        except Exception as e:
            print(f"[ERROR] Failed to start: {e}")
            return 1

    # Background: Gunicorn (single worker in gunicorn_config.py)
    print("Starting Gunicorn (see gunicorn_config.py)...\n")
    env = os.environ.copy()
    env["APP_HOME"] = str(APP_DIR)
    env["SERVICE_HOST"] = env.get("SERVICE_HOST", "0.0.0.0")
    env["SERVICE_PORT"] = str(port)

    with open(LOG_FILE, "a", encoding="utf-8") as log:
        proc = subprocess.Popen(
            [
                sys.executable,
                "-m",
                "gunicorn",
                "-c",
                str(GUNICORN_CFG),
                "app:app",
            ],
            cwd=str(APP_DIR),
            env=env,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )

    time.sleep(2)
    if proc.poll() is not None:
        print("[ERROR] Gunicorn exited immediately. Check logs:")
        print(f"        {LOG_FILE}\n")
        return 1

    try:
        PID_FILE.write_text(f"{proc.pid}:{port}")
    except OSError as e:
        print(f"[WARN] Could not write PID file: {e}")

    print(f"[OK] Vecta AI started (Gunicorn master PID {proc.pid}, port {port})")
    print(f"\n   Main App:   http://localhost:{port}")
    print(f"   Validator:  http://localhost:{port}/validate")
    print(f"\n   Logs: {LOG_FILE}")
    print(f"   Stop: ./vecta stop\n")
    return 0


def cmd_stop(_args):
    print_banner()
    pid, port = get_pid_info()

    if not pid:
        print("[INFO] Not running (no PID file).\n")
        return 0

    if not is_process_running(pid):
        print(f"[INFO] Stale PID {pid}; cleaning up.\n")
        try:
            PID_FILE.unlink()
        except OSError:
            pass
        return 0

    print(f"Stopping Vecta AI (PID {pid}, port {port})...")
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(15):
            time.sleep(1)
            if not is_process_running(pid):
                print("[OK] Stopped.\n")
                try:
                    PID_FILE.unlink()
                except OSError:
                    pass
                return 0
        print("[WARN] Forcing SIGKILL...")
        os.kill(pid, signal.SIGKILL)
        time.sleep(1)
    except Exception as e:
        print(f"[ERROR] {e}\n")
        return 1

    try:
        PID_FILE.unlink()
    except OSError:
        pass
    print("[OK] Stopped.\n")
    return 0


def cmd_restart(_args):
    print_banner()
    _, port_saved = get_pid_info()
    cmd_stop(_args)
    time.sleep(1)
    ns = argparse.Namespace(foreground=False, port=port_saved)
    return cmd_start(ns)


def cmd_status(_args):
    print_banner()
    pid, port = get_pid_info()
    print("Vecta AI Status")
    print("─" * 70)

    if not pid:
        print("Status:  NOT RUNNING\n")
        print("Start:   ./vecta install   # first time")
        print("         ./vecta start\n")
        return 0

    if is_process_running(pid):
        print("Status:  RUNNING")
        print(f"PID:     {pid}")
        print(f"Port:    {port or os.environ.get('SERVICE_PORT', '?')}")
        if port:
            print("\nAccess:")
            print(f"  http://localhost:{port}/")
        print("\nStop:    ./vecta stop")
        print("Restart: ./vecta restart\n")
    else:
        print(f"Status:  NOT RUNNING (stale PID {pid})\n")
        print("Run: ./vecta stop   # cleanup")
        print("     ./vecta start\n")

    return 0


def cmd_logs(args):
    print_banner()
    lines = args.lines
    if not LOG_FILE.exists():
        print("No log file yet.\n")
        return 0
    print(f"Last {lines} lines of {LOG_FILE}:")
    print("─" * 70)
    try:
        text = LOG_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
        for line in text[-lines:]:
            print(line)
    except Exception as e:
        print(f"Error: {e}")
    print(f"\nFull log: {LOG_FILE}\n")
    return 0


def print_banner():
    print("")
    print("=" * 70)
    print("  Vecta AI — Medical Analysis Platform")
    print("=" * 70)
    print("")


def main():
    parser = argparse.ArgumentParser(
        description="Vecta AI local service (install, Gunicorn/Flask, stop, status, logs)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  ./vecta install
  ./vecta start                 # Gunicorn in background
  ./vecta start -f              # Flask dev server (foreground)
  ./vecta start -p 8090
  ./vecta stop && ./vecta status
Environment:
  VECTA_PIP_USER=0   Disable pip --user when using a venv
  SERVICE_PORT       Default port if -p not passed
        """,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("install", help="pip install -r requirements.txt")

    p_start = sub.add_parser("start", help="Start service (Gunicorn background, or -f for Flask dev)")
    p_start.add_argument("-f", "--foreground", action="store_true", help="Run python app.py (dev server)")
    p_start.add_argument("-p", "--port", type=int, default=None, metavar="PORT", help="Listen port (default 8085)")

    sub.add_parser("stop", help="Stop Gunicorn / service using vecta_ai.pid")

    sub.add_parser("restart", help="stop then start (background Gunicorn)")

    sub.add_parser("status", help="Show PID and port")

    p_logs = sub.add_parser("logs", help="Tail application log file")
    p_logs.add_argument("-n", "--lines", type=int, default=50, help="Lines to show (default 50)")

    args = parser.parse_args()

    if args.command == "install":
        return cmd_install(args)
    if args.command == "start":
        return cmd_start(args)
    if args.command == "stop":
        return cmd_stop(args)
    if args.command == "restart":
        return cmd_restart(args)
    if args.command == "status":
        return cmd_status(args)
    if args.command == "logs":
        return cmd_logs(args)
    parser.error("unknown command")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nInterrupted.")
        sys.exit(130)
